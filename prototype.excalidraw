      "updated": 1786229301416,
      "link": null,
      "locked": false,
      "text": "MediAgentState\n{\nmessages: Conversation history (LangGraph managed, auto-appended).\n        raw_case: The original unstructured patient case text.\n        patient_profile: Structured output from the Intake Agent.\n        drug_interactions: List of DDIs found by the DDI Agent.\n        risk_level: Overall risk assessment (drives HITL routing).\n        guideline_matches: Retrieved guideline chunks from the RAG Agent.\n        clinical_report: Final synthesized report from the Synthesis Agent.\n        medications_checked: Drug names that were checked (audit trail).\n        normalization_failures: Drugs that RxNorm couldn't resolve.\n        agent_errors: Errors from any agent (graceful degradation tracking).\n}",
      "fontSize": 45.92976098714462,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MediAgentState\n{\nmessages: Conversation history (LangGraph managed, auto-appended).\n        raw_case: The original unstructured patient case text.\n        patient_profile: Structured output from the Intake Agent.\n        drug_interactions: List of DDIs found by the DDI Agent.\n        risk_level: Overall risk assessment (drives HITL routing).\n        guideline_matches: Retrieved guideline chunks from the RAG Agent.\n        clinical_report: Final synthesized report from the Synthesis Agent.\n        medications_checked: Drug names that were checked (audit trail).\n        normalization_failures: Drugs that RxNorm couldn't resolve.\n        agent_errors: Errors from any agent (graceful degradation tracking).\n}",
      "autoResize": true,
      "lineHeight": 1.15
    },
